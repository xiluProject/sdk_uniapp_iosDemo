export const loadRewardVideoAd = function (options: XiluLoadAdOptions): void {
  runOnMain(() => {
    const events = options.events ?? ({} as XiluAdEvents);
    if (!isInitialized()) {
      events.onFail?.("SDK 未初始化");
      return;
