    }
    rewardVideoAd!.showAd(from = rewardVideoVC!);
  });
};

// ------------------------------------------------------------
// 信息流
// ------------------------------------------------------------

function loadNativeAdInternal(options: XiluLoadAdOptions, isTemplate: boolean): void {
  runOnMain(() => {
    const events = options.events ?? ({} as XiluAdEvents);
    if (!isInitialized()) {
      events.onFail?.("SDK 未初始化");
      return;
    }
    const vc = getTopViewController();
    if (vc == null) {
      events.onFail?.("无法获取 ViewController");
      return;
    }

    nativeAd?.p_release();
    clearNativeContainer();
    nativeAd = null;

    const width = screenWidth();
    const top = options.top ?? 170;
    const height = options.height ?? (screenHeight() - top - safeAreaBottom());

    const host = ensureNativeWindow(top, height);
    const container = UIScrollView();
    container.frame = xRect(0, 0, width, height);
    container.backgroundColor = UIColor(red = 0.97, green = 0.97, blue = 0.97, alpha = 1);
    container.showsVerticalScrollIndicator = true;
    container.alwaysBounceVertical = true;
    container.contentSize = xSize(width, 0);
    host.addSubview(container);
    host.bringSubviewToFront(container);
    nativeContainer = container;
    nativeContentY = 0;

    const adSize = ADXiluAdSize(width = cgf(width), height = 300);
    const count = options.count ?? 3;
    const ad = ADXiluNativeAd(adPosId = options.posId, adSize = adSize, count = cgi(count));
    ad.isTemplate = isTemplate;
    ad.nativeViewController = vc;
    const delegate = new NativeAdDelegate(events, isTemplate);
    ad.delegate = delegate;

    nativeAd = ad;
    nativeDelegate = delegate;

    const originClose = events.onClose;
    events.onClose = (): void => {
      runOnMain(() => {
        clearNativeContainer();
        destroyNativeWindow();
        originClose?.();
      });
    };

    ad.loadAd();   // 只加载，onReceive 时 delegate 只暂存
  });
}

export const loadNativeTemplateAd = function (options: XiluLoadAdOptions): void {
  loadNativeAdInternal(options, true);
};

export const loadNativeRenderAd = function (options: XiluLoadAdOptions): void {
  loadNativeAdInternal(options, false);
};

export const showNativeTemplateAd = function (): void {
  runOnMain(() => {
    if (nativeDelegate == null) {
      console.log("[xiluAdSdk] showNativeTemplateAd：未加载，请先 loadNativeTemplateAd");
      return;
    }
    nativeDelegate!.renderPendingAdInfos();
  });
};

export const showNativeRenderAd = function (): void {
  runOnMain(() => {
    if (nativeDelegate == null) {
      console.log("[xiluAdSdk] showNativeRenderAd：未加载，请先 loadNativeRenderAd");
      return;
    }
    nativeDelegate!.renderPendingAdInfos();
  });
};

export const addNativeTestCards = function (count: number): void {
  runOnMain(() => {
    const container = nativeContainer;
    if (container == null) {
      console.log("[xiluAdSdk] addNativeTestCards：容器不存在，请先 loadNativeTemplateAd 或 loadNativeRenderAd");
      return;
    }
    const n = count <= 0 ? 3 : cgi(count);
    const width = screenWidth();
    for (let i = 0; i < n; i++) {
      const card = makeMockNativeCard(width, i + 1);
      const h = num(card.frame.size.height);
      card.frame = xRect(0, nativeContentY, width, h);
      container!.addSubview(card);
      nativeContentY += h + 8;
    }
    container!.contentSize = xSize(width, nativeContentY + 24);
    console.log(`[xiluAdSdk] 已追加 ${n} 张测试卡片，contentHeight=${nativeContentY}`);
  });
};

// ------------------------------------------------------------
// 销毁
// ------------------------------------------------------------

export const destroyAd = function (type: string): void {
  runOnMain(() => {
    keepAlive(splashDelegate, bannerDelegate, interstitialDelegate,
      rewardVideoDelegate, nativeDelegate);

    if (type == "splash") {
      splashAd?.p_release();
      splashAd = null as ADXiluSplashAd | null;
      splashDelegate = null as BaseAdDelegate | null;
    } else if (type == "banner") {
      bannerAd?.p_release();
      removeView(bannerContainer);
      bannerAd = null as ADXiluBannerAd | null;
      bannerContainer = null as UIView | null;
      bannerDelegate = null as BaseAdDelegate | null;
    } else if (type == "interstitial") {
      interstitialAd?.p_release();
      interstitialAd = null as ADXiluInterstitialAd | null;
      interstitialDelegate = null as BaseAdDelegate | null;
      interstitialVC = null as UIViewController | null;
    } else if (type == "rewardVideo") {
      rewardVideoAd?.p_release();
      rewardVideoAd = null as ADXiluRewardVodAd | null;
      rewardVideoDelegate = null as RewardVideoDelegate | null;
      rewardVideoVC = null as UIViewController | null;
    } else if (type == "native") {
      nativeAd?.p_release();
      clearNativeContainer();
      nativeAd = null as ADXiluNativeAd | null;
      nativeDelegate = null as NativeAdDelegate | null;
      destroyNativeWindow();
    }
  });
};
